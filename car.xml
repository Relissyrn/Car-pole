<mujoco model="four_wheel_forward_car">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <default>
    <joint damping="0.15" armature="0.005"/>
    <geom condim="6" friction="1.5 0.01 0.001" solref="0.005 1"/>
    <default class="wheel">
      <geom type="cylinder" size="0.10 0.045" quat="0.7071068 0.7071068 0 0"
            density="900" rgba="0.12 0.12 0.12 1"/>
    </default>
  </default>

  <worldbody>
    <geom name="ground" type="plane" size="0 0 0.05" rgba="0.28 0.32 0.36 1"/>
    <geom name="finish_line" type="box" pos="15 0 0" size="0.025 3 0.02"
          rgba="0 1 0 1" contype="0" conaffinity="0"/>
    <light name="overhead" pos="0 0 4" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>

    <body name="chassis" pos="0 0 0.18">
      <freejoint name="root"/>
      <geom name="chassis_body" type="box" pos="0 0 0.11"
            size="0.34 0.19 0.07" density="650"
            rgba="0.85 0.18 0.08 1"/>

      <body name="front_left_steer" pos="0.24 0.24 -0.09">
        <inertial pos="0 0 0" mass="0.15" diaginertia="0.0005 0.0005 0.0005"/>
        <joint name="steer_left" type="hinge" axis="0 0 1"
               range="-0.005 0.005" limited="true"/>
        <body name="front_left_wheel">
          <joint name="wheel_front_left" type="hinge" axis="0 1 0"/>
          <geom name="tire_front_left" class="wheel"/>
        </body>
      </body>
      <body name="front_right_steer" pos="0.24 -0.24 -0.09">
        <inertial pos="0 0 0" mass="0.15" diaginertia="0.0005 0.0005 0.0005"/>
        <joint name="steer_right" type="hinge" axis="0 0 1"
               range="-0.005 0.005" limited="true"/>
        <body name="front_right_wheel">
          <joint name="wheel_front_right" type="hinge" axis="0 1 0"/>
          <geom name="tire_front_right" class="wheel"/>
        </body>
      </body>
      <body name="rear_left_wheel" pos="-0.24 0.24 -0.09">
        <joint name="wheel_rear_left" type="hinge" axis="0 1 0"/>
        <geom name="tire_rear_left" class="wheel"/>
      </body>
      <body name="rear_right_wheel" pos="-0.24 -0.24 -0.09">
        <joint name="wheel_rear_right" type="hinge" axis="0 1 0"/>
        <geom name="tire_rear_right" class="wheel"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="drive_front_left" joint="wheel_front_left" gear="8"
           ctrlrange="-1 1"/>
    <motor name="drive_front_right" joint="wheel_front_right" gear="8"
           ctrlrange="-1 1"/>
    <motor name="drive_rear_left" joint="wheel_rear_left" gear="8"
           ctrlrange="-1 1"/>
    <motor name="drive_rear_right" joint="wheel_rear_right" gear="8"
           ctrlrange="-1 1"/>
    <position name="steer_left" joint="steer_left" gear="200" kp="0.0002"
              ctrlrange="-1 1" forcerange="-0.1 0.1" forcelimited="true"/>
    <position name="steer_right" joint="steer_right" gear="200" kp="0.0002"
              ctrlrange="-1 1" forcerange="-0.1 0.1" forcelimited="true"/>
  </actuator>
</mujoco>
